{
  "name": "venoms-map-painter",
  "version": "2.2.1",
  "description": "A desktop tool for painting CK3 mod province maps with automatic file generation",
  "author": "Ven0m",
  "license": "MIT",
  "homepage": "https://github.com/Vem0n/venoms-map-painter",
  "repository": { "type": "git", "url": "https://github.com/Vem0n/venoms-map-painter.git" },
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run setup:electron && node scripts/electron-dev.js dev",
    "build": "electron-vite build",
    "start": "npm run setup:electron && node scripts/electron-dev.js preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.yml",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "setup:electron": "install-electron",
    "test:electron": "npm run setup:electron && node scripts/smoke-electron.js"
  },
  "dependencies": {
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "cross-env": "10.1.0",
    "electron": "44.7.0",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "5.0.4",
    "@types/pngjs": "6.0.5"
  },
  "engines": {
    "node": "^24.21.0",
    "npm": "^12.2.0"
  },
  "packageManager": "npm@12.2.0",
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false,
    "fsevents": false
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
